<?xml version="1.0" encoding="utf-8"?>
<!-- The PC on your home Wi-Fi is reached over plain http (it never leaves your network);
     away from home the app uses the HTTPS Tailscale address. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
